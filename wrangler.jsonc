{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cota-clara-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Los produce `opennextjs-cloudflare build`; no cambiar.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": { "enabled": true },

  // Optimización de imágenes de next/image sobre Workers.
  "images": { "binding": "IMAGES" },

  // Base del acceso corporativo, usuarios, sesiones, bitácora y el inventario
  // de propiedades. En local no se usa: `next dev` monta una D1 aparte en
  // .wrangler/state, y las tablas de la real se crean con `npm run db:schema`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cota-clara-db",
      "database_id": "607ed92b-1635-447e-9923-54a80b3714b5"
    }
  ],

  // Fotos de las propiedades. Crear el bucket antes del primer deploy con
  // `npx wrangler r2 bucket create cota-clara-fotos`, si no el deploy falla.
  // No es público: se sirve por /fotos/.
  "r2_buckets": [
    {
      "binding": "FOTOS",
      "bucket_name": "cota-clara-fotos"
    }
  ]
}
