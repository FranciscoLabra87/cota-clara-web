{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cota-clara-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Los produce `opennextjs-cloudflare build`; no cambiar.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": { "enabled": true },

  // Optimización de imágenes de next/image sobre Workers.
  "images": { "binding": "IMAGES" },

  // Base del acceso corporativo: usuarios, sesiones y bitácora.
  // El database_id lo entrega `npx wrangler d1 create cota-clara-db` y hay que
  // pegarlo aquí antes del primer deploy. En local no se usa: `next dev` monta
  // una D1 de mentira en .wrangler/state.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cota-clara-db",
      "database_id": "PENDIENTE-CORRER-WRANGLER-D1-CREATE"
    }
  ],

  // Fotos de las propiedades. Crear el bucket antes del primer deploy con
  // `npx wrangler r2 bucket create cota-clara-fotos`, si no el deploy falla.
  // No es público: se sirve por /api/propiedades/foto/.
  "r2_buckets": [
    {
      "binding": "FOTOS",
      "bucket_name": "cota-clara-fotos"
    }
  ]
}
