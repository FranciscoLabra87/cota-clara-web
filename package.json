{
  "name": "cota-clara-web",
  "version": "1.0.0",
  "description": "Sitio web de Cota Clara, Patrimonio Inmobiliario",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:schema": "wrangler d1 execute cota-clara-db --remote --file=db/schema.sql",
    "db:local-schema": "wrangler d1 execute cota-clara-db --local --persist-to .wrangler/state --file=db/schema.sql",
    "db:seed": "wrangler d1 execute cota-clara-db --remote --file=db/seed-propiedades.sql",
    "db:local-seed": "wrangler d1 execute cota-clara-db --local --persist-to .wrangler/state --file=db/seed-propiedades.sql",
    "db:local-consulta": "wrangler d1 execute cota-clara-db --local --persist-to .wrangler/state --command"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.38.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.161.0"
  },
  "private": true,
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.8"
  }
}
