{
  "name": "cota-clara-web",
  "version": "1.0.0",
  "description": "Sitio web de Cota Clara, Patrimonio Inmobiliario",
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:schema": "wrangler d1 execute cota-clara-db --remote --file=db/schema.sql",
    "db:local-schema": "wrangler d1 execute cota-clara-db --local --persist-to .wrangler/state --file=db/schema.sql",
    "db:seed": "wrangler d1 execute cota-clara-db --remote --file=db/import-palma-fuentes.sql",
    "db:local-seed": "wrangler d1 execute cota-clara-db --local --persist-to .wrangler/state --file=db/import-palma-fuentes.sql",
    "db:local-consulta": "wrangler d1 execute cota-clara-db --local --persist-to .wrangler/state --command"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "leaflet": "^1.9.4",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.38.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  },
  "private": true,
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.8"
  }
}
