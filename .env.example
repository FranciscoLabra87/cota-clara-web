# Correo saliente del hosting para avisos y respuestas desde el panel.
# Copia este archivo como .env.local solo para desarrollo. En Cloudflare Workers
# configura estos valores como secretos; no se publican en el repositorio.
# Los tickets llegan a D1 aunque SMTP no esté configurado.

# Servidor SMTP público del hosting (sin proxy de Cloudflare).
SMTP_HOST=

# 465 para TLS implícito o 587 para STARTTLS obligatorio.
SMTP_PORT=465

# Usuario y contraseña de la cuenta de correo del hosting.
SMTP_USER=
SMTP_PASS=

# Remitente autorizado por esa cuenta de correo.
LEADS_FROM="Cota Clara <contacto@cotaclara.cl>"

# Destino del aviso interno de nuevos tickets; vacío usa contacto@cotaclara.cl.
# Acepta varias direcciones separadas por coma.
LEADS_TO=
