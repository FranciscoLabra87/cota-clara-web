# Correo saliente: avisos al equipo, confirmaciones a quien llena un formulario
# y respuestas desde el panel. Copia este archivo como .env.local solo para
# desarrollo. En Cloudflare Workers configura estos valores como secretos; no se
# publican en el repositorio. Los tickets llegan a D1 aunque no haya correo.
#
# Con RESEND_API_KEY sale por Resend y no se usa SMTP. Sin ella, sale por el
# SMTP del hosting.

# Clave de API de Resend, tras verificar cotaclara.cl en el servicio.
RESEND_API_KEY=

# Remitente de todo lo automático, el «no responder». Con Resend no necesita
# una casilla real; con SMTP debe ser la cuenta de SMTP_USER.
LEADS_FROM="Cota Clara <info@cotaclara.cl>"

# Destino del aviso interno de nuevos tickets; vacío usa contacto@cotaclara.cl.
# Acepta varias direcciones separadas por coma.
LEADS_TO=

# ─── Solo si no hay RESEND_API_KEY ───

# Servidor SMTP público del hosting (sin proxy de Cloudflare).
SMTP_HOST=

# 465 para TLS implícito o 587 para STARTTLS obligatorio.
SMTP_PORT=465

# Usuario y contraseña de la cuenta de correo del hosting.
SMTP_USER=
SMTP_PASS=

# Identificador público de GA4, disponible al construir Next (no es una clave secreta).
# Vacío: no se carga Google Analytics. Solo se carga tras aceptar analítica.
NEXT_PUBLIC_GA4_ID=
# Solo poner 1 después de desactivar Medición mejorada en el flujo web de GA4.
# El sitio envía page_view, contact_click y generate_lead de forma controlada.
NEXT_PUBLIC_GA4_MANUAL_EVENTS=0
