# Envío de los leads de /api/contacto por correo, con Resend.
#
# Copia este archivo como .env.local y completa los valores. .env.local no se
# commitea (está en .gitignore). Sin RESEND_API_KEY ni LEADS_FROM el formulario
# sigue funcionando, pero el lead solo queda en el log del servidor.

# API key de https://resend.com/api-keys
RESEND_API_KEY=

# Remitente. El dominio tiene que estar verificado en Resend (Domains > Add domain).
# Para probar antes de verificar cotaclara.cl sirve "Cota Clara <onboarding@resend.dev>",
# que solo entrega al correo dueño de la cuenta de Resend.
LEADS_FROM="Cota Clara <leads@cotaclara.cl>"

# Destino de los leads. Vacío usa site.email (contacto@cotaclara.cl).
# Acepta varios separados por coma.
LEADS_TO=
